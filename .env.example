# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_USE_SUPABASE=true

# Client Portal (Vendor Tool) — target for the "Client Portal" button on the login screen.
# Set this to the deployed vendor-app URL.
VITE_VENDOR_TOOL_URL=https://vccdev.vercel.app/vendor-tool

# Microsoft 365 (for Vercel serverless functions)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_LIST_ID=

# Supabase Service Role (for Vercel serverless functions only - never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by the scripts/ automation (import_sow.py, sync_resource_list.py,
# sync-locations.cjs). Anon key is enough for those; timesheet_automation.py
# needs SUPABASE_SERVICE_ROLE_KEY above instead.
SUPABASE_KEY=your-anon-key

# Anthropic API (scripts/ai_review.py, scripts/hiring_automation.py)
ANTHROPIC_API_KEY=sk-ant-...

# SOW Workflow
FINANCE_APPROVER_EMAIL=nick@visualcomfort.com

# DocuSign (optional — SOW signature workflow)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi