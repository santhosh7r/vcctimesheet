{
  "crons": [
    {
      "path": "/api/cron/sharepoint-sync",
      "schedule": "*/15 2-12 * * 1-5"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 3 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
